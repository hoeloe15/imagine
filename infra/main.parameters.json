{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "containerImage": {
      "value": "${IMAGINE_CONTAINER_IMAGE=ghcr.io/hoeloe15/imagine:edge}"
    },
    "openRouterSecretInVault": {
      "value": "${IMAGINE_OPENROUTER_SECRET_IN_VAULT=false}"
    },
    "azureOpenAiSecretInVault": {
      "value": "${IMAGINE_AZURE_OPENAI_SECRET_IN_VAULT=false}"
    },
    "authEnabled": {
      "value": "${IMAGINE_AUTH_ENABLED=false}"
    },
    "authTenantId": {
      "value": "${IMAGINE_AUTH_TENANT_ID=}"
    },
    "authClientId": {
      "value": "${IMAGINE_AUTH_CLIENT_ID=}"
    },
    "authExtraAudiences": {
      "value": "${IMAGINE_AUTH_EXTRA_AUDIENCES=}"
    },
    "authRequiredScope": {
      "value": "${IMAGINE_AUTH_REQUIRED_SCOPE=}"
    },
    "authIssuer": {
      "value": "${IMAGINE_AUTH_ISSUER=}"
    },
    "authMetadataUrl": {
      "value": "${IMAGINE_AUTH_METADATA_URL=}"
    },
    "authAudienceOverride": {
      "value": "${IMAGINE_AUTH_AUDIENCE=}"
    },
    "authAllowedSubjects": {
      "value": "${IMAGINE_ALLOWED_SUBJECTS=}"
    },
    "portalEnabled": {
      "value": "${IMAGINE_PORTAL_ENABLED=false}"
    },
    "portalClientId": {
      "value": "${IMAGINE_PORTAL_WORKOS_CLIENT_ID=}"
    },
    "imagineConfigJson": {
      "value": "${IMAGINE_CONFIG_JSON=}"
    },
    "foundryResourceId": {
      "value": "${IMAGINE_FOUNDRY_RESOURCE_ID=}"
    },
    "outputSink": {
      "value": "${IMAGINE_OUTPUT_SINK=local}"
    },
    "outputBlobUrlTtlHours": {
      "value": "${IMAGINE_OUTPUT_BLOB_URL_TTL_HOURS=}"
    }
  }
}
