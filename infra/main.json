{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "8901658421384478682"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "metadata": {
        "description": "Name of the azd environment. Every resource name derives from it."
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Azure region for all resources. Must support Azure Container Apps."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource group to deploy into. Defaults to rg-<environmentName>."
      }
    },
    "principalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object id of the principal running azd. Gets Key Vault Secrets Officer so it can set the provider secrets; an RBAC vault gives no data-plane access to subscription Owner alone."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/hoeloe15/imagine:edge",
      "metadata": {
        "description": "Image the container app runs until `azd deploy` replaces it with a locally built one. See ADR 0019."
      }
    },
    "openRouterSecretInVault": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set to true only after `az keyvault secret set --name openrouter-api-key` has run. A Key Vault reference to a secret that does not exist fails the revision. See ADR 0019."
      }
    },
    "azureOpenAiSecretInVault": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set to true only after `az keyvault secret set --name azure-openai-api-key` has run."
      }
    },
    "authEnabled": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Turn on IMAGINE_AUTH_* on the container app. Leave false until the Entra app registration of #44 exists; the server refuses to start half-configured (ADR 0017)."
      }
    },
    "authTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tenant whose tokens are accepted. Defaults to the deployment tenant."
      }
    },
    "authClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application (client) id of the MCP app registration. Adds api://<id> as an accepted audience."
      }
    },
    "authExtraAudiences": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Extra accepted audiences, comma separated. The deployed https://<fqdn>/mcp URL is always included."
      }
    },
    "authRequiredScope": {
      "type": "string",
      "defaultValue": "access_as_user",
      "metadata": {
        "description": "Scope or app role a caller must hold."
      }
    },
    "authIssuer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Accepted issuer. Empty lets the server derive it from the tenant."
      }
    }
  },
  "variables": {
    "tags": {
      "azd-env-name": "[parameters('environmentName')]"
    },
    "rgName": "[if(empty(parameters('resourceGroupName')), format('rg-{0}', parameters('environmentName')), parameters('resourceGroupName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('rgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "imagine-resources",
      "resourceGroup": "[variables('rgName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "principalId": {
            "value": "[parameters('principalId')]"
          },
          "containerImage": {
            "value": "[parameters('containerImage')]"
          },
          "openRouterSecretInVault": {
            "value": "[parameters('openRouterSecretInVault')]"
          },
          "azureOpenAiSecretInVault": {
            "value": "[parameters('azureOpenAiSecretInVault')]"
          },
          "authEnabled": {
            "value": "[parameters('authEnabled')]"
          },
          "authTenantId": {
            "value": "[parameters('authTenantId')]"
          },
          "authClientId": {
            "value": "[parameters('authClientId')]"
          },
          "authExtraAudiences": {
            "value": "[parameters('authExtraAudiences')]"
          },
          "authRequiredScope": {
            "value": "[parameters('authRequiredScope')]"
          },
          "authIssuer": {
            "value": "[parameters('authIssuer')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "10153445111062803922"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "principalId": {
              "type": "string"
            },
            "containerImage": {
              "type": "string"
            },
            "openRouterSecretInVault": {
              "type": "bool"
            },
            "azureOpenAiSecretInVault": {
              "type": "bool"
            },
            "authEnabled": {
              "type": "bool"
            },
            "authTenantId": {
              "type": "string"
            },
            "authClientId": {
              "type": "string"
            },
            "authExtraAudiences": {
              "type": "string"
            },
            "authRequiredScope": {
              "type": "string"
            },
            "authIssuer": {
              "type": "string"
            },
            "targetPort": {
              "type": "int",
              "defaultValue": 8080,
              "metadata": {
                "description": "Port the container listens on. The entrypoint resolves IMAGINE_HTTP_PORT, then PORT, then 8080 (ADR 0018)."
              }
            }
          },
          "variables": {
            "token": "[toLower(uniqueString(subscription().id, parameters('environmentName'), parameters('location')))]",
            "logAnalyticsName": "[format('log-{0}-{1}', parameters('environmentName'), variables('token'))]",
            "containerAppsEnvironmentName": "[format('cae-{0}-{1}', parameters('environmentName'), variables('token'))]",
            "containerAppName": "[format('ca-imagine-{0}', variables('token'))]",
            "registryName": "[format('acr{0}', variables('token'))]",
            "identityName": "[format('id-imagine-{0}', variables('token'))]",
            "keyVaultName": "[format('kv-imagine-{0}', variables('token'))]",
            "openRouterSecretName": "openrouter-api-key",
            "azureOpenAiSecretName": "azure-openai-api-key",
            "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
            "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
            "keyVaultSecretsOfficerRoleId": "b86a8fe4-44ce-4948-aba4-0b2d0ea19d21",
            "apiAudience": "[if(empty(parameters('authClientId')), '', format(',api://{0}', parameters('authClientId')))]",
            "extraAudience": "[if(empty(parameters('authExtraAudiences')), '', format(',{0}', parameters('authExtraAudiences')))]",
            "providerEnv": "[concat(if(parameters('openRouterSecretInVault'), createArray(createObject('name', 'OPENROUTER_API_KEY', 'secretRef', variables('openRouterSecretName'))), createArray()), if(parameters('azureOpenAiSecretInVault'), createArray(createObject('name', 'AZURE_OPENAI_API_KEY', 'secretRef', variables('azureOpenAiSecretName'))), createArray()))]"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[variables('identityName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]"
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[variables('logAnalyticsName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2024-03-01",
              "name": "[variables('containerAppsEnvironmentName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2022-10-01').customerId]",
                    "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2022-10-01').primarySharedKey]"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
              ]
            },
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[variables('registryName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Basic"
              },
              "properties": {
                "adminUserEnabled": false
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[variables('keyVaultName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7,
                "publicNetworkAccess": "Enabled"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
              "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('acrPullRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
                "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('keyVaultSecretsUserRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
              ]
            },
            {
              "condition": "[not(empty(parameters('principalId')))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), parameters('principalId'), variables('keyVaultSecretsOfficerRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsOfficerRoleId'))]",
                "principalId": "[parameters('principalId')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[variables('containerAppName')]",
              "location": "[parameters('location')]",
              "tags": "[union(parameters('tags'), createObject('azd-service-name', 'imagine'))]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))]": {}
                }
              },
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "ingress": {
                    "external": true,
                    "targetPort": "[parameters('targetPort')]",
                    "transport": "auto",
                    "allowInsecure": false
                  },
                  "registries": [
                    {
                      "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]",
                      "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
                    }
                  ],
                  "secrets": "[concat(if(parameters('openRouterSecretInVault'), createArray(createObject('name', variables('openRouterSecretName'), 'keyVaultUrl', format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri, variables('openRouterSecretName')), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))), createArray()), if(parameters('azureOpenAiSecretInVault'), createArray(createObject('name', variables('azureOpenAiSecretName'), 'keyVaultUrl', format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri, variables('azureOpenAiSecretName')), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))), createArray()))]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "imagine",
                      "image": "[parameters('containerImage')]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1.0Gi"
                      },
                      "env": "[concat(createArray(createObject('name', 'PORT', 'value', string(parameters('targetPort')))), variables('providerEnv'), if(parameters('authEnabled'), concat(createArray(createObject('name', 'IMAGINE_AUTH_TENANT_ID', 'value', if(empty(parameters('authTenantId')), subscription().tenantId, parameters('authTenantId'))), createObject('name', 'IMAGINE_AUTH_AUDIENCE', 'value', format('{0}{1}{2}', format('{0}/mcp', format('https://{0}.{1}', variables('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName')), '2024-03-01').defaultDomain)), variables('apiAudience'), variables('extraAudience'))), createObject('name', 'IMAGINE_AUTH_REQUIRED_SCOPE', 'value', parameters('authRequiredScope'))), if(empty(parameters('authIssuer')), createArray(), createArray(createObject('name', 'IMAGINE_AUTH_ISSUER', 'value', parameters('authIssuer'))))), createArray()))]",
                      "probes": [
                        {
                          "type": "Startup",
                          "httpGet": {
                            "path": "/healthz",
                            "port": "[parameters('targetPort')]"
                          },
                          "initialDelaySeconds": 3,
                          "periodSeconds": 3,
                          "failureThreshold": 20
                        },
                        {
                          "type": "Readiness",
                          "httpGet": {
                            "path": "/healthz",
                            "port": "[parameters('targetPort')]"
                          },
                          "periodSeconds": 10,
                          "failureThreshold": 3
                        },
                        {
                          "type": "Liveness",
                          "httpGet": {
                            "path": "/healthz",
                            "port": "[parameters('targetPort')]"
                          },
                          "periodSeconds": 30,
                          "failureThreshold": 3
                        }
                      ]
                    }
                  ],
                  "scale": {
                    "minReplicas": 1,
                    "maxReplicas": 3
                  }
                }
              },
              "dependsOn": [
                "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('acrPullRoleId')))]",
                "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
                "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('keyVaultSecretsUserRoleId')))]",
                "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]"
              ]
            }
          ],
          "outputs": {
            "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]"
            },
            "AZURE_CONTAINER_REGISTRY_NAME": {
              "type": "string",
              "value": "[variables('registryName')]"
            },
            "AZURE_CONTAINER_APP_NAME": {
              "type": "string",
              "value": "[variables('containerAppName')]"
            },
            "AZURE_CONTAINER_APPS_ENVIRONMENT_NAME": {
              "type": "string",
              "value": "[variables('containerAppsEnvironmentName')]"
            },
            "AZURE_KEY_VAULT_NAME": {
              "type": "string",
              "value": "[variables('keyVaultName')]"
            },
            "AZURE_KEY_VAULT_ENDPOINT": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri]"
            },
            "AZURE_MANAGED_IDENTITY_NAME": {
              "type": "string",
              "value": "[variables('identityName')]"
            },
            "AZURE_MANAGED_IDENTITY_CLIENT_ID": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
            },
            "AZURE_MANAGED_IDENTITY_PRINCIPAL_ID": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
            },
            "MCP_ENDPOINT_URL": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
            },
            "MCP_RESOURCE_URI": {
              "type": "string",
              "value": "[format('{0}/mcp', format('https://{0}.{1}', variables('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName')), '2024-03-01').defaultDomain))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('rgName'))]"
      ]
    }
  ],
  "outputs": {
    "AZURE_LOCATION": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "AZURE_TENANT_ID": {
      "type": "string",
      "value": "[subscription().tenantId]"
    },
    "AZURE_RESOURCE_GROUP": {
      "type": "string",
      "value": "[variables('rgName')]"
    },
    "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_CONTAINER_REGISTRY_ENDPOINT.value]"
    },
    "AZURE_CONTAINER_REGISTRY_NAME": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_CONTAINER_REGISTRY_NAME.value]"
    },
    "AZURE_CONTAINER_APP_NAME": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_CONTAINER_APP_NAME.value]"
    },
    "AZURE_CONTAINER_APPS_ENVIRONMENT_NAME": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_NAME.value]"
    },
    "AZURE_KEY_VAULT_NAME": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_KEY_VAULT_NAME.value]"
    },
    "AZURE_KEY_VAULT_ENDPOINT": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_KEY_VAULT_ENDPOINT.value]"
    },
    "AZURE_MANAGED_IDENTITY_NAME": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_MANAGED_IDENTITY_NAME.value]"
    },
    "AZURE_MANAGED_IDENTITY_CLIENT_ID": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_MANAGED_IDENTITY_CLIENT_ID.value]"
    },
    "AZURE_MANAGED_IDENTITY_PRINCIPAL_ID": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.AZURE_MANAGED_IDENTITY_PRINCIPAL_ID.value]"
    },
    "MCP_ENDPOINT_URL": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.MCP_ENDPOINT_URL.value]"
    },
    "MCP_RESOURCE_URI": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('rgName')), 'Microsoft.Resources/deployments', 'imagine-resources'), '2025-04-01').outputs.MCP_RESOURCE_URI.value]"
    }
  }
}