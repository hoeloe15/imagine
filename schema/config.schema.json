{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hoeloe15/imagine/main/schema/config.schema.json",
  "title": "imagine configuration",
  "description": "Configuration for the imagine MCP server. API keys are never stored here: api_key_env names the environment variable holding the key, and api_key_secret names a Key Vault secret.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "default": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": "string",
          "enum": ["1024x1024", "1536x1024", "1024x1536", "auto"]
        },
        "use_case": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "text_in_image",
                "photoreal",
                "illustration",
                "diagram",
                "fast_bulk"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "api_key_env": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "api_key_secret": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "api_version": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string",
            "enum": ["entra", "api_key"]
          },
          "deployments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "deployment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dialect": {
                      "type": "string",
                      "enum": ["openai", "mai"]
                    },
                    "endpoint": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["deployment"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sink": {
          "type": "string",
          "enum": ["local", "blob"]
        },
        "blob": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "account_url": {
                  "type": "string",
                  "format": "uri"
                },
                "container": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$"
                },
                "url_ttl_hours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_usd_per_session": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_usd_per_day": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "on_exceed": {
          "type": "string",
          "enum": ["refuse", "warn"]
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"]
        },
        "cost_log": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
