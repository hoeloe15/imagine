{
  "$id": "https://raw.githubusercontent.com/hoeloe15/imagine/main/schema/config.schema.json",
  "title": "imagine configuration",
  "description": "Configuration for the imagine MCP server. API keys are never stored here: api_key_env names the environment variable holding the key.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "default": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": "string",
          "enum": ["1024x1024", "1536x1024", "1024x1536", "auto"]
        },
        "use_case": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "text_in_image",
                "photoreal",
                "illustration",
                "diagram",
                "fast_bulk"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "api_key_env": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "api_version": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string",
            "enum": ["entra", "api_key"]
          },
          "deployments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_usd_per_session": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_usd_per_day": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "on_exceed": {
          "type": "string",
          "enum": ["refuse", "warn"]
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"]
        },
        "cost_log": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
